# Copy to .env.local. Variable names only — never commit real values.
# When these are unset the app runs in local mode (seeded curriculum + browser localStorage progress).

# Public Supabase project URL and anon (publishable) key — safe for the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ and never import from client components.
SUPABASE_SERVICE_ROLE_KEY=

# "local" (default) or "supabase" — selects the progress repository implementation.
NEXT_PUBLIC_PERSISTENCE_MODE=local
